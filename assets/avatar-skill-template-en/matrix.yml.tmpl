name: {{REPO_NAME}}
owner: {{OWNER_NAME}}
identity_mode: {{IDENTITY_MODE}}
psp_display_name: {{PSP_DISPLAY_NAME}}
positioning: {{DISPLAY_NAME}}'s openLifeOS, public boundary, capability, and long-term context entrypoint
language: {{LANGUAGE}}
process_log_language: {{PROCESS_LOG_LANGUAGE}}
visibility: {{VISIBILITY}}
created_at: {{TODAY}}
lifeos_status:
  path: LIFEOS_STATUS.yml
  lifecycle: {{LIFEOS_LIFECYCLE}}
  upload_version: {{UPLOAD_VERSION}}
  delivery_version: {{DELIVERY_VERSION}}
  current_version: {{CURRENT_LIFEOS_VERSION}}
root_agent:
  id: {{SKILL_ID}}
  path: .
  entrypoint: AGENT.md
  role: avatar reading, skill routing, status, maturity, and owner-alignment protocol
layers:
  intake:
    path: metabolism/inbox/
    purpose: Evidence intake layer. Registers owner-approved material entrypoints, boundaries, intended use, and processing state without storing secrets or unredacted private source text.
  runtime:
    path: runtime/
    purpose: Activity-scene layer. Agents run sessions here; sessions produce outputs, observations, and lessons that later flow into evolution for review and distillation.
    sessions: runtime/sessions/
    runtime_skills: runtime/runtime-skills/
    runtime_lessons: runtime/runtime-lessons/
  evolution:
    path: evolution/
    purpose: Evolution layer. Reviews runtime lessons, finished outputs, and new evidence through IPO Reverse, owner alignment, and versioned updates.
    ipo: evolution/ipo/
  capabilities:
    path: capabilities/
    purpose: Capability layer. Describes callable, candidate, verified, and promotion-ready capabilities without hard-coding factual memory into Skills.
  roles:
    path: identities/
    purpose: Role layer. Defines LifeOS identities, permission boundaries, collaboration postures, and areas where it must not speak on the owner's behalf.
  work:
    path: work/
    purpose: Work layer. Holds public-safe work entrypoints, project indexes, collaboration context, and execution surfaces without copying private work materials.
artifacts:
  current_registry:
    path: artifacts/current.yml
    role: Machine-readable latest pointer for all core process artifacts; agents and runtime projections must resolve this first.
  soul_policy:
    produced: false
    role: SOUL.md is paused as a LifeOS source artifact; if a target runtime needs it, generate only a runtime projection from PSP XML.
  design:
    current_entrypoint: DESIGN.md
    canonical_xml_entrypoint: identity/design/current/DESIGN_TASTE.xml
    versioned_artifacts: identity/design/DESIGN_TASTE-<timestamp>.xml + identity/design/DESIGN-<timestamp>.md
    role: Global aesthetics, expression preferences, and design judgment entrypoint; DESIGN_TASTE.xml is the source artifact and DESIGN.md is the projection.
identity:
  current_registry:
    path: identity/current.yml
    role: Machine-readable active pointer for Wenxin and PSP; runtime projections must resolve this first.
  public_profile:
    path: identity/public-profile/profile.yml
    role: Public, owner-confirmed objective identity configuration.
  public_positioning:
    path: identity/inneratlas/current/INNERATLAS_REPORT.xml
    active_registry: identity/wenxin/versions.yml
    status: source-scope-needed
    role: Self-discovery, capability map, public positioning, and candidate Skill recommendations generated by InnerAtlas/Wenxin.
person_models:
  - id: {{PERSON_ID}}
    path: identity/psp/{{PERSON_ID}}/current/PSP_REPORT.xml
    active_registry: identity/psp/{{PERSON_ID}}/current.yml
    versions_ledger: identity/psp/{{PERSON_ID}}/versions.yml
    evidence_maturity: identity/psp/{{PERSON_ID}}/current/EVIDENCE_MATURITY.xml
    initialization: identity/psp/{{PERSON_ID}}/INITIALIZATION.md
    display_name: {{PSP_DISPLAY_NAME}}
    status: intake-only
    scope: Current PSP pseudonym, evidence boundary, pending intake, ontology map, operating axes, delegation boundary, behavior boundaries, confidence, and validation method.
aesthetics:
  current_entrypoint: DESIGN.md
  canonical_xml_entrypoint: identity/design/current/DESIGN_TASTE.xml
  versions_ledger: identity/design/versions.yml
  changelog: identity/design/changelog.md
  scope: Global expression preferences, design preferences, narrative rhythm, visual tendencies, fonts, colors, text color, spacing, grid, radius, motion, media, evidence presentation, accessibility, and standards for good work. DESIGN_TASTE.xml is the machine-readable source artifact; DESIGN.md is the human/agent-readable projection.
vendored_skill_sources:
  self_evolution_skills:
    - id: wenxin
      path: evolution/organ-systems/wenxin
      entrypoint: evolution/organ-systems/wenxin/SKILL.md
      repository: https://github.com/MetaInFLow/innerAtlas-skill.git
      install_mode: github-release-archive
      role: Complete InnerAtlas/Wenxin Skill for self-discovery, public positioning, capability map, gap analysis, and candidate Skill recommendations.
    - id: psp
      path: evolution/organ-systems/psp
      entrypoint: evolution/organ-systems/psp/SKILL.md
      repository: https://github.com/MetaInFLow/psp-skill.git
      install_mode: github-release-archive
      role: Complete PSP Skill for person model, behavior boundaries, language/judgment patterns, confidence, and validation examples.
    - id: ipo-reverse
      path: evolution/organ-systems/ipo-reverse
      entrypoint: evolution/organ-systems/ipo-reverse/SKILL.md
      repository: https://github.com/MetaInFLow/ipo-reverse-skill.git
      install_mode: github-release-archive
      license: PolyForm-Noncommercial-1.0.0
      role: Complete IPO Reverse Skill for reconstructing evidence, hidden cognitive tasks, middle-layer artifacts, and reusable IPO from finished outputs.
    - id: taste-generator
      path: evolution/organ-systems/taste-generator
      entrypoint: evolution/organ-systems/taste-generator/SKILL.md
      repository: https://github.com/MetaInFLow/taste-generator-skill.git
      install_mode: github-release-archive
      license: PolyForm-Noncommercial-1.0.0
      role: Complete Taste Generator Skill for creating design preference selectors, summarizing owner choices, producing DESIGN_TASTE.xml first, then generating global DESIGN.md.
  runtime_skills: []
  distilled_meta_skills: []
  memory: []
self_evolution:
  purpose: Let {{REPO_NAME}} keep updating "who I am", "what runtime can do", "which evidence may become a distilled meta skill", and "how AI should understand me."
  skills:
    - wenxin-self-discovery
    - psp
    - ipo-reverse
    - taste-generator
    - hermes-sync
skill_taxonomy:
  runtime_skill:
    role: Executes concrete tasks and produces task outputs, run logs, and lesson events.
    example: Hermes GitHub SnapAF-skills
  distilled_meta_skill:
    role: Encodes reusable judgment, routing, methodology, review gates, and decision patterns.
    example: owner-grown-meta-skill
  promotion_gate:
    rule: Runtime evidence may upgrade into a distilled meta skill only after IPO Reverse and owner alignment.
cognition_objects:
  taxonomy: identity/cognition/object-taxonomy.yml
  data_contracts: identity/cognition/data-contracts.yml
  rule: memory answers what is true; skill answers how to do it; hybrid input must be split.
memory_taxonomy:
  working_lessons: runtime/memory/working-lessons/
  long_term_memory: identity/memories/long-term/
  distilled_knowledge: capabilities/memory/distilled-knowledge/
skill_layers:
  runtime: docs/skill-system/runtime-skill-candidates.md
  meta: identity/wenxin/skill-summaries/
  bindings: identity/cognition/skill-bindings/data-sources.yml
  placement_policy: candidate skills stay in identity/wenxin or docs/skill-system until promoted into real capabilities/<capability-id>/SKILL.md packages.
evidence_sufficiency:
  path: docs/evidence-sufficiency.md
  maturity_levels: scaffold, evidence-limited-v0, public-v0, research-grade, avatar-grade
  rule: progress gate passing means structure readiness, not content maturity.
self_evolution_output_standards:
  path: docs/self-evolution-output-standards.md
  rule: Wenxin, PSP XML, Design, Taste Generator, and IPO Reverse artifacts pass only when key fields are filled; otherwise they must declare insufficient evidence and list missing_information. SOUL.md is paused as a LifeOS source artifact.
sync:
  hermes:
    path: integrations/hermes.yml
    role: Continuously receives new evidence from GitHub, Feishu/Lark, wiki diffs, or approved materials, then drives updates to Wenxin, PSP, skill recommendations, and routing.
  memory_wiki:
    path: identity/memories/wiki-repo.yml
    rule: The public layer stores only derived index/approved-derived content; the private wiki is for trusted collaboration; when server-rsync is configured as authoritative source, the server is the single source of truth.
  data_sources:
    path: integrations/data-sources.yml
    rule: External systems must declare authority, visibility, token policy, and allowed targets before they feed memory, knowledge, or skill updates.
