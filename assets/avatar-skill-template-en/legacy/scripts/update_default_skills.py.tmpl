#!/usr/bin/env python3
"""Plan or apply owner-reviewed release/archive updates for openLifeOS Skills."""

from __future__ import annotations

import argparse
import datetime as dt
import json
import shutil
import subprocess
import tarfile
import tempfile
import urllib.error
import urllib.request
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
CONFIG = ROOT / "skills" / "default-skills" / "skill-updates.yml"
SETUP_CONFIG = ROOT / "replicateme.yml"


def read_process_log_language() -> str:
    if not SETUP_CONFIG.exists():
        return "en-US"
    config: dict[str, str] = {}
    for raw_line in SETUP_CONFIG.read_text(encoding="utf-8").splitlines():
        if ":" not in raw_line or raw_line.startswith((" ", "\t", "-")):
            continue
        key, value = raw_line.split(":", 1)
        config[key.strip()] = value.strip().strip('"').strip("'")
    return config.get("process_log_language") or config.get("language") or "en-US"


def parse_skill_updates(path: Path) -> dict[str, dict[str, str]]:
    skills: dict[str, dict[str, str]] = {}
    current: str | None = None
    in_skills = False
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        if not raw_line.strip() or raw_line.lstrip().startswith("#"):
            continue
        if raw_line == "skills:":
            in_skills = True
            continue
        if not in_skills:
            continue
        if raw_line.startswith("  ") and not raw_line.startswith("    ") and raw_line.rstrip().endswith(":"):
            current = raw_line.strip().removesuffix(":")
            skills[current] = {}
            continue
        if current and raw_line.startswith("    ") and ":" in raw_line:
            key, value = raw_line.strip().split(":", 1)
            skills[current][key] = value.strip().strip('"').strip("'")
    return skills


def github_json(url: str) -> dict[str, object] | None:
    request = urllib.request.Request(url, headers={"Accept": "application/vnd.github+json", "User-Agent": "openLifeOS"})
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return json.loads(response.read().decode("utf-8"))
    except (urllib.error.HTTPError, urllib.error.URLError, TimeoutError, json.JSONDecodeError):
        return None


def download_archive(repo: str, archive: Path) -> tuple[str, str]:
    if shutil.which("gh"):
        release = subprocess.run(
            ["gh", "release", "view", "-R", repo, "--json", "tagName", "--jq", ".tagName"],
            text=True,
            capture_output=True,
            check=False,
        )
        tag = release.stdout.strip()
        if release.returncode == 0 and tag:
            result = subprocess.run(
                ["gh", "release", "download", tag, "-R", repo, "--archive=tar.gz", "--output", str(archive)],
                text=True,
                capture_output=True,
                check=False,
            )
            if result.returncode == 0:
                return "release", tag

    latest = github_json(f"https://api.github.com/repos/{repo}/releases/latest")
    if latest and isinstance(latest.get("tarball_url"), str):
        urllib.request.urlretrieve(str(latest["tarball_url"]), archive)
        return "release", str(latest.get("tag_name") or "latest")

    repo_meta = github_json(f"https://api.github.com/repos/{repo}")
    branch = str(repo_meta.get("default_branch") or "main") if repo_meta else "main"
    urllib.request.urlretrieve(f"https://api.github.com/repos/{repo}/tarball/{branch}", archive)
    return "branch", branch


def extract_payload(archive: Path, dest: Path) -> None:
    with tarfile.open(archive, "r:gz") as tar:
        try:
            tar.extractall(dest, filter="data")
        except TypeError:
            tar.extractall(dest)
    roots = [path for path in dest.iterdir() if path.is_dir()]
    if len(roots) != 1:
        raise RuntimeError("Unexpected GitHub archive layout")
    payload = roots[0]
    for ignored in [".git", ".github"]:
        ignored_path = payload / ignored
        if ignored_path.exists():
            shutil.rmtree(ignored_path)


def source_manifest(skill_id: str, repo: str, source_type: str, source_ref: str) -> str:
    return "\n".join(
        [
            "schema: openlifeos.skill-source.v1",
            f"skill_id: {skill_id}",
            f"github_repo: {repo}",
            f"source_type: {source_type}",
            f"source_ref: {source_ref}",
            f"installed_at: {dt.datetime.now().astimezone().replace(microsecond=0).isoformat()}",
            "install_mode: github-archive-vendor",
            "submodule: false",
            "",
        ]
    )


def diff_summary(local_path: Path, new_path: Path) -> str:
    if not local_path.exists():
        return "(new install)"
    result = subprocess.run(
        ["diff", "-ruN", "--exclude", ".openlifeos-skill-source.yml", str(local_path), str(new_path)],
        text=True,
        capture_output=True,
        check=False,
    )
    lines = result.stdout.splitlines()
    if not lines:
        return "(no content diff)"
    return "\n".join(lines[:120] + (["... diff truncated ..."] if len(lines) > 120 else []))


def update_skill(skill_id: str, spec: dict[str, str], apply: bool, zh: bool) -> None:
    repo = spec.get("github_repo")
    local_path = spec.get("local_path")
    if not repo or not local_path:
        raise SystemExit(f"Invalid skill update config for {skill_id}")
    target = ROOT / local_path
    with tempfile.TemporaryDirectory(prefix=f"openlifeos-skill-update-{skill_id}-") as tmp:
        tmp_root = Path(tmp)
        archive = tmp_root / f"{skill_id}.tar.gz"
        source_type, source_ref = download_archive(repo, archive)
        extract_root = tmp_root / "extract"
        extract_root.mkdir()
        extract_payload(archive, extract_root)
        payload = next(path for path in extract_root.iterdir() if path.is_dir())
        (payload / ".openlifeos-skill-source.yml").write_text(
            source_manifest(skill_id, repo, source_type, source_ref),
            encoding="utf-8",
        )
        print(f"\n[{skill_id}] {repo} @ {source_type}:{source_ref}")
        print(diff_summary(target, payload))
        if apply:
            if target.exists():
                shutil.rmtree(target)
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copytree(payload, target)
            print("已应用更新。" if zh else "Update applied.")
        else:
            print("未覆盖本地 Skill；加 --apply 才会应用。" if zh else "Local Skill was not overwritten; pass --apply to apply.")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--apply", action="store_true", help="Apply the downloaded release/archive after showing the diff.")
    parser.add_argument("--skill", action="append", help="Skill id to update. Defaults to all configured skills.")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    if not CONFIG.exists():
        raise SystemExit(f"Missing update config: {CONFIG}")
    zh = read_process_log_language() == "zh-CN"
    print("当前阶段：Default Skill Release Update / 内置 Skill Release 更新" if zh else "Stage: Default Skill Release Update")
    print("默认只展示 diff；只有 --apply 会覆盖本地 vendored Skill。" if zh else "Default is diff-only; only --apply overwrites local vendored Skills.")
    skills = parse_skill_updates(CONFIG)
    selected = args.skill or sorted(skills)
    for skill_id in selected:
        if skill_id not in skills:
            raise SystemExit(f"Unknown skill id: {skill_id}")
        update_skill(skill_id, skills[skill_id], args.apply, zh)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
