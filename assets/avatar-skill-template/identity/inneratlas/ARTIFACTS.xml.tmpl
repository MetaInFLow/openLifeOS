<inneratlas_artifacts schema="inneratlas-artifacts" version="1.0">
  <owner>{{OWNER_NAME}}</owner>
  <display_name>{{DISPLAY_NAME}}</display_name>
  <artifact_root>identity/inneratlas</artifact_root>
  <current>current/INNERATLAS_REPORT.xml</current>
  <active_version>versions/INNERATLAS_REPORT.{{ARTIFACT_TIMESTAMP}}.xml</active_version>
  <status>source-scope-needed</status>
  <policy>新建 avatar 的 InnerAtlas 只能使用用户本轮直接提供的材料，或用户明确授权的外部资料入口和范围；默认不读取 openLifeOS output/meta、其他 avatar repo、历史 identity/wenxin 或 identity/inneratlas 报告。</policy>
</inneratlas_artifacts>
