<inneratlas_report schema="inneratlas-report" version="1.2" artifact_name="INNERATLAS_REPORT.xml" version_id="{{ARTIFACT_TIMESTAMP}}" language="{{LANGUAGE}}">
  <metadata>
    <generated_at>{{CREATED_AT}}</generated_at>
    <last_updated>{{CREATED_AT}}</last_updated>
    <artifact_root>identity/inneratlas</artifact_root>
    <current_path>current/INNERATLAS_REPORT.xml</current_path>
    <version_path>versions/INNERATLAS_REPORT.{{ARTIFACT_TIMESTAMP}}.xml</version_path>
    <subject_display_name>{{DISPLAY_NAME}}</subject_display_name>
    <assessment_mode>complete</assessment_mode>
    <workflow_state>source_scope_needed</workflow_state>
    <report_status>draft</report_status>
    <completion_percent>0</completion_percent>
  </metadata>

  <source_discovery presentation="source_inventory">
    <scanned_at>{{CREATED_AT}}</scanned_at>
    <scan_status>not_run</scan_status>
    <discovery_policy>Discovery only. Do not ingest local, private, remote, or account-bound material without explicit user approval. For a new avatar, exclude this openLifeOS factory output/meta, other avatar repos, historical identity/wenxin or identity/inneratlas reports, and prior Wenxin conclusions unless the user explicitly provides a specific artifact as current-run material.</discovery_policy>
    <cli_candidates></cli_candidates>
  </source_discovery>

  <missing_information presentation="doctor_queue">
    <status>has_missing_required_fields</status>
    <missing field="source_material_scope" status="unknown" required_for_100="true" answer_type="approval_scope_table">
      <why_needed>New-avatar InnerAtlas must start from current-run material, not inherited openLifeOS output/meta artifacts or historical Wenxin reports.</why_needed>
      <question_context>
        <item id="direct_materials" label="用户本轮直接提供的文件、文字、PDF、聊天记录或项目文档"></item>
        <item id="gh" label="gh: 用户明确授权的 GitHub repo / issue / PR 范围"></item>
        <item id="git" label="git: 用户明确授权的本地 repo 和提交历史范围"></item>
        <item id="rg_mdfind" label="rg/mdfind: 用户明确授权的本地目录，默认排除 openLifeOS/output/meta 和历史问心/InnerAtlas 报告"></item>
        <item id="lark_feishu" label="Lark/Feishu: 用户明确授权的聊天、会议纪要、docs 或 wiki 范围"></item>
      </question_context>
      <next_question>请明确这次给 {{DISPLAY_NAME}} 新建 avatar 时允许使用哪些材料入口和范围。下面每一项请写 allowed、denied、allowed_with_limits 或 not_available，并补充具体范围；本地 openLifeOS 的 output/meta、其他 avatar repo、历史 identity/wenxin 或 identity/inneratlas 报告默认不使用，除非你明确指定某一份历史产物作为本轮材料。</next_question>
    </missing>
  </missing_information>

  <iteration_log presentation="append_only">
    <entry date="{{CREATED_AT}}">
      <trigger>Initialized fresh InnerAtlas source artifact for a new avatar.</trigger>
      <changes>Created draft INNERATLAS_REPORT.xml with no inherited Wenxin conclusions. Waiting for source material scope approval.</changes>
    </entry>
  </iteration_log>
</inneratlas_report>
