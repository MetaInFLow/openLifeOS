status: configured
update_policy: owner-reviewed
rule: 完整 self-evolution skills 安装在 evolution/organ-systems/；默认通过 GitHub latest release archive 拉取为普通目录，不使用 submodule。更新必须先生成 diff，并由 owner 确认后再覆盖本地 Skill。
default_source:
  provider: github
  repo: "{{DEFAULT_SKILLS_REPO}}"
  ref: "{{DEFAULT_SKILLS_REF}}"
  path: integrations/skill-sources/default-skills
skills:
  wenxin:
    local_path: evolution/organ-systems/wenxin
    github_repo: "{{WENXIN_SKILL_REPO}}"
    ref: latest
    update_mode: owner-reviewed-release-archive
  psp:
    local_path: evolution/organ-systems/psp
    github_repo: "{{PSP_SKILL_REPO}}"
    ref: latest
    update_mode: owner-reviewed-release-archive
  ipo-reverse:
    local_path: evolution/organ-systems/ipo-reverse
    github_repo: "{{IPO_REVERSE_SKILL_REPO}}"
    ref: latest
    update_mode: owner-reviewed-release-archive
  taste-generator:
    local_path: evolution/organ-systems/taste-generator
    github_repo: "{{TASTE_GENERATOR_SKILL_REPO}}"
    ref: latest
    update_mode: owner-reviewed-release-archive
